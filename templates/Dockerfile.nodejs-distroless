# Security-First Node.js MCP Server Template (Distroless - Preferred)
#
# This template uses Google's Distroless images for maximum security:
# - Minimal attack surface (no shell, no package managers)
# - Runs as non-root user (UID 65532)
# - Multi-stage build for clean separation of concerns
# - Proper file ownership and permissions

ARG SRC_REPO=https://github.com/example/mcp-server-repo
ARG SRC_HASH=

# BUILD STAGE - Uses full Node.js image for building
FROM node:24 AS builder

# Install git for cloning repositories
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends git

# Clone source repository
RUN git clone "$SRC_REPO" /repo

WORKDIR /repo

# Checkout specific commit hash for security
RUN git checkout "$SRC_HASH"

# For monorepo structures, cd to the specific server directory
# WORKDIR /repo/src/your-server-name

# Install dependencies
RUN --mount=type=cache,target=/root/.npm \
    npm install

# Run TypeScript build (if applicable)
RUN npm run build

# Install production dependencies only
RUN --mount=type=cache,target=/root/.npm-production \
    npm ci --ignore-scripts --omit=dev

# RUNTIME STAGE - Distroless for maximum security
FROM gcr.io/distroless/nodejs24-debian12:nonroot

WORKDIR /app
ENV NODE_ENV=production

# Copy built application with proper ownership for non-root user (UID 65532)
COPY --from=builder --chown=65532:65532 /repo/dist /app/dist
COPY --from=builder --chown=65532:65532 /repo/node_modules /app/node_modules
COPY --from=builder --chown=65532:65532 /repo/package.json /app/package.json

# Explicitly set non-root user (redundant with :nonroot base but explicit for clarity)
USER 65532

# Use array form for ENTRYPOINT for better signal handling
ENTRYPOINT ["node", "dist/index.js"]

# Health check (optional - adjust command as needed)
# HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
#   CMD node -e "process.exit(0)" || exit 1
